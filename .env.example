# Modelo das variaveis de ambiente do backend.
# O Spring NAO le este arquivo automaticamente: copie os valores para a sua
# Run Configuration (IntelliJ/VS Code), para o terminal ou para o Render.
# NUNCA commite o .env com valores reais.

# Conexao (Supabase -> Connect -> Server / Session pooler, porta 5432)
DB_URL=jdbc:postgresql://aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.<project-ref>
DB_PASSWORD=<senha-do-banco>

# Porta local (o Render injeta a dele)
PORT=8080

# Origens do frontend liberadas no CORS (separadas por virgula)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Cookies de sessao: em producao (HTTPS, front em outro dominio)
# use SESSION_COOKIE_SAME_SITE=none e SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false

# Rotas de destino depois do login (opcional)
REDIRECT_PROFESSOR=/professor
REDIRECT_COORDENACAO=/coordenacao
